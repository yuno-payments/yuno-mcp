{
  "name": "@yuno/yuno-mcp",
  "version": "0.4.4-test.2",
  "description": "Yuno MCP server: create and manage payments, subscriptions, customers, payment methods, checkouts, recipients, installment plans, payment links, and routing on the Yuno payments platform.",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client/index.js",
      "types": "./dist/client/index.d.ts"
    },
    "./schemas": {
      "import": "./dist/schemas/index.js",
      "types": "./dist/schemas/index.d.ts"
    },
    "./tools": {
      "import": "./dist/tools/index.js",
      "types": "./dist/tools/index.d.ts"
    },
    "./types": {
      "types": "./dist/types/index.d.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc --noEmit && bunchee",
    "test": "rstest run",
    "lint": "eslint src",
    "ca:login": "aws codeartifact login --tool npm --repository yuno --domain yuno --namespace @yuno --profile registry"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@rstest/core": "^0.0.7",
    "@types/node": "22.15.3",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "bunchee": "^6.5.4",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "prettier": "^3.6.2",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.36.0"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "ajv": "^8.18.0"
    },
    "hono": "^4.12.32",
    "qs": "^6.15.2",
    "minimatch": "^10.2.1",
    "rollup": "^4.59.0",
    "fast-uri": "^3.1.4",
    "ip-address": "^10.3.1",
    "body-parser": "^2.3.0",
    "js-yaml": "^4.3.0",
    "brace-expansion": "^5.0.8"
  }
}
